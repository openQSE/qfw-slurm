QFW_PREFIX=/opt/openqse/qfw
QFW_VENV=/opt/openqse/qfw-venv
QFW_SHARED_ROOT=/shared/openqse/qfw
QFW_SLURM_CONFIG=/etc/openqse/qfw-slurm/gateway.yaml
DEFW_LOG_DIR=/var/lib/qfw-slurm-gateway/defw
# Uncomment to run the gateway on DEFw v2. The site configuration named in
# the gateway file must then be one whose directory runs on DEFw v2.
#QFW_DEFW_VERSION=2
